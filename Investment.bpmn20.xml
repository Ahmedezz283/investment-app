  <process id="Inv-v3" name="Investment" isExecutable="true">
    <startEvent id="startEvent1" flowable:formFieldValidation="true"></startEvent>
    <sequenceFlow id="flowStartToParallel" sourceRef="startEvent1" targetRef="parallelSplit"></sequenceFlow>
    <parallelGateway id="parallelSplit"></parallelGateway>
    <serviceTask id="taskNationalId" name="National id validation" flowable:expression="${true}"></serviceTask>
    <serviceTask id="taskTaxClearance" name="Tax clearance" flowable:expression="${true}"></serviceTask>
    <sequenceFlow id="flowToNationalId" sourceRef="parallelSplit" targetRef="taskNationalId"></sequenceFlow>
    <sequenceFlow id="flowToTax" sourceRef="parallelSplit" targetRef="taskTaxClearance"></sequenceFlow>
    <parallelGateway id="parallelJoin"></parallelGateway>
    <sequenceFlow id="flowFromTax" sourceRef="taskTaxClearance" targetRef="parallelJoin"></sequenceFlow>
    <sequenceFlow id="flowFromNationalId" sourceRef="taskNationalId" targetRef="parallelJoin"></sequenceFlow>
    <exclusiveGateway id="gatewayRiskLevel" name="Risk level?"></exclusiveGateway>
    <sequenceFlow id="flowMediumHighRisk" name="MEDIUM or HIGH" sourceRef="gatewayRiskLevel" targetRef="taskAssignActor">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${riskLevel == 'MEDIUM' || riskLevel == 'HIGH'}]]></conditionExpression>
    </sequenceFlow>
    <scriptTask id="taskAssignActor" name="Assign actor to approve" scriptFormat="javascript" flowable:autoStoreVariables="false">
      <script><![CDATA[
// The backend passes the department names as a JSON string because Flowable
// cannot serialize a JavaScript array received as a process variable.
var configuredGroups = JSON.parse(approvalGroupsJson);
var approvalGroups = new java.util.ArrayList();
for (var i = 0; i < configuredGroups.length; i++) {
  approvalGroups.add(configuredGroups[i]);
}
execution.setVariable('approvalGroups', approvalGroups);
]]></script>
    </scriptTask>
    <sequenceFlow id="flowAssignToApprove" sourceRef="taskAssignActor" targetRef="taskApprove"></sequenceFlow>
    <userTask id="taskApprove" name="Approve company registration" flowable:candidateGroups="${approvalGroup}" flowable:formFieldValidation="true">
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="approvalGroups" flowable:elementVariable="approvalGroup">
        <completionCondition>${nrOfCompletedInstances &gt;= minApprovalsRequired}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <serviceTask id="taskEscalate" name="Escalate to the head of the managers" flowable:expression="${true}"></serviceTask>
    <endEvent id="endEscalation"></endEvent>
    <sequenceFlow id="flowEscalateToEnd" sourceRef="taskEscalate" targetRef="endEscalation"></sequenceFlow>
    <sequenceFlow id="flowApproveToDecision" sourceRef="taskApprove" targetRef="gatewayApproved"></sequenceFlow>
    <exclusiveGateway id="gatewayApproved" name="approved"></exclusiveGateway>
    <serviceTask id="taskNotifyMissedData" name="notify investor with missed data" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string><![CDATA[POST]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestUrl">
          <flowable:string><![CDATA[http://host.docker.internal:3000/notifications/missing-data]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestHeaders">
          <flowable:string><![CDATA[Content-Type: application/json]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression><![CDATA[{"investmentRequestId": "${investmentRequestId}", "investorId": "${investorId}"}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="requestBodyEncoding">
          <flowable:string><![CDATA[UTF-8]]></flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flowNotifyToEnterData" sourceRef="taskNotifyMissedData" targetRef="taskEnterMissingData"></sequenceFlow>
    <userTask id="taskEnterMissingData" name="enter the missing data" flowable:formFieldValidation="true"></userTask>
    <serviceTask id="taskNotifyRejection" name="notify user with rejection" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string><![CDATA[POST]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestUrl">
          <flowable:string><![CDATA[http://host.docker.internal:3000/notifications/rejection]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestHeaders">
          <flowable:string><![CDATA[Content-Type: application/json]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression><![CDATA[{"investmentRequestId": "${investmentRequestId}", "investorId": "${investorId}"}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="requestBodyEncoding">
          <flowable:string><![CDATA[UTF-8]]></flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="endRejection"></endEvent>
    <sequenceFlow id="flowRejectToEnd" sourceRef="taskNotifyRejection" targetRef="endRejection"></sequenceFlow>
    <serviceTask id="taskCompanyRegistration" name="company registration" flowable:expression="${true}"></serviceTask>
    <sequenceFlow id="flowRegToNotify" sourceRef="taskCompanyRegistration" targetRef="taskNotifyApproval"></sequenceFlow>
    <serviceTask id="taskNotifyApproval" name="notify user with registration approval" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string><![CDATA[POST]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestUrl">
          <flowable:string><![CDATA[http://host.docker.internal:3000/notifications/approval]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestHeaders">
          <flowable:string><![CDATA[Content-Type: application/json]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression><![CDATA[{"investmentRequestId": "${investmentRequestId}", "investorId": "${investorId}"}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="requestBodyEncoding">
          <flowable:string><![CDATA[UTF-8]]></flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="endApproved"></endEvent>
    <sequenceFlow id="flowNotifyToEnd" sourceRef="taskNotifyApproval" targetRef="endApproved"></sequenceFlow>
    <sequenceFlow id="flowYes" name="yes" sourceRef="gatewayApproved" targetRef="taskCompanyRegistration">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowNo" name="no" sourceRef="gatewayApproved" targetRef="taskNotifyRejection">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowPending" name="pending" sourceRef="gatewayApproved" targetRef="taskNotifyMissedData">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == null || approved == 'pending'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowSlaEscalation" sourceRef="sid-086DC497-DAF7-4651-A568-5D8777B60D6C" targetRef="taskEscalate"></sequenceFlow>
    <sequenceFlow id="flowLowRisk" name="LOW" sourceRef="gatewayRiskLevel" targetRef="taskCompanyRegistration">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${riskLevel == 'LOW'}]]></conditionExpression>
    </sequenceFlow>
    <boundaryEvent id="sid-086DC497-DAF7-4651-A568-5D8777B60D6C" attachedToRef="taskApprove" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>${slaDuration}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flowJoinToRisk" sourceRef="parallelJoin" targetRef="sid-1E6A7C2B-7242-4D4E-A88B-3781BB5DA109"></sequenceFlow>
    <serviceTask id="sid-1E6A7C2B-7242-4D4E-A88B-3781BB5DA109" name="gorules evaluation" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string><![CDATA[POST]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestUrl">
          <flowable:expression><![CDATA[http://host.docker.internal:3000/gorules/${ruleName}/evaluate]]></flowable:expression>
        </flowable:field>
        <flowable:field name="requestHeaders">
          <flowable:string><![CDATA[Content-Type: application/json]]></flowable:string>
        </flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression><![CDATA[{"context":{"investmentAmount":${investmentAmount}}}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
