<?xml version="1.0" encoding="UTF-8"?>
<!-- Classic JRXML 6.x — compatible with JasperReports Server 7.8 -->
<!-- No uuid on jasperReport, no element kind= attributes -->
<jasperReport
	name="investment"
	language="java"
	pageWidth="842"
	pageHeight="595"
	orientation="Landscape"
	whenNoDataType="AllSectionsNoDetail"
	columnWidth="802"
	leftMargin="20"
	rightMargin="20"
	topMargin="20"
	bottomMargin="20">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="InvestmentDB"/>
	<style name="Title" forecolor="#1A1A1A" fontName="SansSerif" fontSize="20" isBold="true"/>
	<style name="ColumnHeader" forecolor="#333333" fontName="SansSerif" fontSize="10" isBold="true"/>
	<style name="Detail" fontName="SansSerif" fontSize="10"/>
	<parameter name="investmentRequestId" class="java.lang.String"/>
	<parameter name="notificationType" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="status" class="java.lang.String"/>
	<field name="risk_level" class="java.lang.String"/>
	<field name="created_at" class="java.util.Date"/>
	<field name="approval_decision" class="java.lang.String"/>
	<field name="approver_name" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<title>
		<band height="70" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="802" height="40" style="Title"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Investment Request Report]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="45" width="802" height="20"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[(($P{notificationType} == null) ? "Investment" : $P{notificationType}) + " report | Request ID: " + (($P{investmentRequestId} == null) ? "" : $P{investmentRequestId})]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="28" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="4" width="110" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Company]]></text>
			</staticText>
			<staticText>
				<reportElement x="110" y="4" width="90" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Amount]]></text>
			</staticText>
			<staticText>
				<reportElement x="200" y="4" width="90" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Status]]></text>
			</staticText>
			<staticText>
				<reportElement x="290" y="4" width="80" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Risk]]></text>
			</staticText>
			<staticText>
				<reportElement x="370" y="4" width="100" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Created]]></text>
			</staticText>
			<staticText>
				<reportElement x="470" y="4" width="110" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Approver]]></text>
			</staticText>
			<staticText>
				<reportElement x="580" y="4" width="100" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Decision]]></text>
			</staticText>
			<staticText>
				<reportElement x="680" y="4" width="122" height="20" style="ColumnHeader"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Department]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="24" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="2" width="110" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{company_name}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" pattern="#,##0.00">
				<reportElement x="110" y="2" width="90" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="200" y="2" width="90" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="290" y="2" width="80" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{risk_level}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" pattern="dd/MM/yyyy">
				<reportElement x="370" y="2" width="100" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{created_at}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="470" y="2" width="110" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{approver_name}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="580" y="2" width="100" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{approval_decision}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="680" y="2" width="122" height="20" style="Detail"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{department_name}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<textField pattern="EEEEE dd MMMMM yyyy">
				<reportElement x="0" y="0" width="250" height="18" style="ColumnHeader"/>
				<textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="650" y="0" width="152" height="18" style="ColumnHeader"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
